#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "moonwalk_mini_wheel"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "moonwalk_mini_wheel"
{
    over "Physics"
    {
        over "L_hip_pitch" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "L_knee_pitch" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "L_ankle_pitch" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "L_wheel_axle" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "R_hip_pitch" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "R_knee_pitch" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "R_ankle_pitch" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "R_wheel_axle" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "L_hip_pitch_actuator"
        {
            uniform double mjc:forceRange:max = 0.8799999952316284
            uniform double mjc:forceRange:min = -0.8799999952316284
            custom rel mjc:target
            append rel mjc:target = </moonwalk_mini_wheel/Physics/L_hip_pitch>
        }

        def MjcActuator "L_knee_pitch_actuator"
        {
            uniform double mjc:forceRange:max = 0.8799999952316284
            uniform double mjc:forceRange:min = -0.8799999952316284
            custom rel mjc:target
            append rel mjc:target = </moonwalk_mini_wheel/Physics/L_knee_pitch>
        }

        def MjcActuator "L_ankle_pitch_actuator"
        {
            uniform double mjc:forceRange:max = 0.8799999952316284
            uniform double mjc:forceRange:min = -0.8799999952316284
            custom rel mjc:target
            append rel mjc:target = </moonwalk_mini_wheel/Physics/L_ankle_pitch>
        }

        def MjcActuator "L_wheel_axle_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            append rel mjc:target = </moonwalk_mini_wheel/Physics/L_wheel_axle>
        }

        def MjcActuator "R_hip_pitch_actuator"
        {
            uniform double mjc:forceRange:max = 0.8799999952316284
            uniform double mjc:forceRange:min = -0.8799999952316284
            custom rel mjc:target
            append rel mjc:target = </moonwalk_mini_wheel/Physics/R_hip_pitch>
        }

        def MjcActuator "R_knee_pitch_actuator"
        {
            uniform double mjc:forceRange:max = 0.8799999952316284
            uniform double mjc:forceRange:min = -0.8799999952316284
            custom rel mjc:target
            append rel mjc:target = </moonwalk_mini_wheel/Physics/R_knee_pitch>
        }

        def MjcActuator "R_ankle_pitch_actuator"
        {
            uniform double mjc:forceRange:max = 0.8799999952316284
            uniform double mjc:forceRange:min = -0.8799999952316284
            custom rel mjc:target
            append rel mjc:target = </moonwalk_mini_wheel/Physics/R_ankle_pitch>
        }

        def MjcActuator "R_wheel_axle_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            append rel mjc:target = </moonwalk_mini_wheel/Physics/R_wheel_axle>
        }
    }
}

