#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "moonwalk_mini_wheel"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "moonwalk_mini_wheel"
{
    over "Physics"
    {
        over "L_hip_pitch" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "L_knee_pitch" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "L_ankle_pitch" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "L_wheel_axle" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "R_hip_pitch" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "R_knee_pitch" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "R_ankle_pitch" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "R_wheel_axle" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

