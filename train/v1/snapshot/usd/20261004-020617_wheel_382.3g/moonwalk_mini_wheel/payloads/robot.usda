#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "moonwalk_mini_wheel"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "moonwalk_mini_wheel" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "L_hip_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "R_hip_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "L_knee_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "L_ankle_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "L_wheel_axle" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "R_knee_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "R_ankle_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "R_wheel_axle" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "L_thigh" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "L_shank" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "L_foot" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "L_wheel" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "R_thigh" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "R_shank" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "R_foot" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "R_wheel" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }
        }
    }
}

