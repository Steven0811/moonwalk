#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "moonwalk_mini_ptfe"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Xform "moonwalk_mini_ptfe" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
    }
    append variantSets = "Physics"
)
{
    def "PhysicsMaterials"
    {
        def Material "ptfe_sole" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.1
            float physics:restitution = 0
            float physics:staticFriction = 0.1
            custom token physxMaterial:frictionCombineMode = "min"
            custom token physxMaterial:restitutionCombineMode = "min"
        }

        def Material "petg_structure" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.4
            custom token physxMaterial:frictionCombineMode = "min"
            custom token physxMaterial:restitutionCombineMode = "min"
        }

        def Material "tpu_tyre" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.9
            float physics:restitution = 0
            float physics:staticFriction = 0.9
            custom token physxMaterial:frictionCombineMode = "min"
            custom token physxMaterial:restitutionCombineMode = "min"
        }

        def Material "tpu_toe_pad" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.75
            float physics:restitution = 0
            float physics:staticFriction = 0.75
            custom token physxMaterial:frictionCombineMode = "min"
            custom token physxMaterial:restitutionCombineMode = "min"
        }
    }

    over "Geometry"
    {
        over "base_link"
        {
            over "L_thigh"
            {
                over "L_shank"
                {
                    over "L_foot"
                    {
                        over "L_foot_toe_pad" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding:physics = </moonwalk_mini_ptfe/PhysicsMaterials/tpu_toe_pad> (
                                bindMaterialAs = "weakerThanDescendants"
                            )
                        }

                        over "L_foot_heel" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding:physics = </moonwalk_mini_ptfe/PhysicsMaterials/ptfe_sole> (
                                bindMaterialAs = "weakerThanDescendants"
                            )
                        }

                        over "L_foot_sole" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding:physics = </moonwalk_mini_ptfe/PhysicsMaterials/ptfe_sole> (
                                bindMaterialAs = "weakerThanDescendants"
                            )
                        }

                        over "L_foot_body" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding:physics = </moonwalk_mini_ptfe/PhysicsMaterials/petg_structure> (
                                bindMaterialAs = "weakerThanDescendants"
                            )
                        }
                    }

                    over "L_shank_body" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding:physics = </moonwalk_mini_ptfe/PhysicsMaterials/petg_structure> (
                            bindMaterialAs = "weakerThanDescendants"
                        )
                    }
                }

                over "L_thigh_body" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </moonwalk_mini_ptfe/PhysicsMaterials/petg_structure> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                }
            }

            over "R_thigh"
            {
                over "R_shank"
                {
                    over "R_foot"
                    {
                        over "R_foot_toe_pad" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding:physics = </moonwalk_mini_ptfe/PhysicsMaterials/tpu_toe_pad> (
                                bindMaterialAs = "weakerThanDescendants"
                            )
                        }

                        over "R_foot_heel" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding:physics = </moonwalk_mini_ptfe/PhysicsMaterials/ptfe_sole> (
                                bindMaterialAs = "weakerThanDescendants"
                            )
                        }

                        over "R_foot_sole" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding:physics = </moonwalk_mini_ptfe/PhysicsMaterials/ptfe_sole> (
                                bindMaterialAs = "weakerThanDescendants"
                            )
                        }

                        over "R_foot_body" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding:physics = </moonwalk_mini_ptfe/PhysicsMaterials/petg_structure> (
                                bindMaterialAs = "weakerThanDescendants"
                            )
                        }
                    }

                    over "R_shank_body" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding:physics = </moonwalk_mini_ptfe/PhysicsMaterials/petg_structure> (
                            bindMaterialAs = "weakerThanDescendants"
                        )
                    }
                }

                over "R_thigh_body" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </moonwalk_mini_ptfe/PhysicsMaterials/petg_structure> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                }
            }

            over "base_link_body" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </moonwalk_mini_ptfe/PhysicsMaterials/petg_structure> (
                    bindMaterialAs = "weakerThanDescendants"
                )
            }

            over "base_link_tray" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </moonwalk_mini_ptfe/PhysicsMaterials/petg_structure> (
                    bindMaterialAs = "weakerThanDescendants"
                )
            }

            over "base_link_battery" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </moonwalk_mini_ptfe/PhysicsMaterials/petg_structure> (
                    bindMaterialAs = "weakerThanDescendants"
                )
            }
        }
    }
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
}

